{
  "id": "a4_invoice",
  "version": 1,
  "paper": {
    "type": "a4",
    "widthMm": 210,
    "heightMm": 297,
    "autoHeight": false,
    "marginMm": 15
  },
  "elements": [
    {
      "id": "company",
      "type": "dynamic_text",
      "key": "{{company.name}} เลขประจำตัวผู้เสียภาษี {{company.taxId}}",
      "x": 0,
      "y": 0,
      "w": 180,
      "h": 10,
      "style": {
        "fontSize": 14,
        "bold": true,
        "isHeader": true
      }
    },
    {
      "id": "invNo",
      "type": "dynamic_text",
      "key": "ใบแจ้งหนี้ เลขที่ {{invoiceNo}} วันที่ {{date}} ครบกำหนด {{dueDate}}",
      "x": 0,
      "y": 15,
      "w": 180,
      "h": 10,
      "style": {
        "fontSize": 11
      }
    },
    {
      "id": "cust2",
      "type": "dynamic_text",
      "key": "ลูกค้า: {{customer.name}} {{customer.address}}",
      "x": 0,
      "y": 28,
      "w": 180,
      "h": 10,
      "style": {
        "fontSize": 10
      }
    },
    {
      "id": "itemsTable",
      "type": "table",
      "key": "{{items}}",
      "x": 0,
      "y": 40,
      "w": 180,
      "h": 200,
      "style": {
        "fontSize": 10
      },
      "columns": [
        {
          "key": "no",
          "label": "ลำดับ"
        },
        {
          "key": "name",
          "label": "รายการ"
        },
        {
          "key": "qty",
          "label": "จำนวน"
        },
        {
          "key": "price",
          "label": "ราคา"
        },
        {
          "key": "total",
          "label": "รวม"
        }
      ]
    }
  ]
}